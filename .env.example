# Copiare in .env e compilare. Nessuna credenziale va scritta in questo file o nel codice.

# Indirizzo pubblico del sito (serve per i link nelle email e nei calendari)
SITE_URL=http://localhost:3000

# demo = dati d'esempio e banner "versione dimostrativa"; live = struttura vera
DATA_MODE=demo

# Password dell'area gestore (/gestione), minimo 12 caratteri
ADMIN_PASSWORD=

# Segreto per la sessione, minimo 32 caratteri.
# Generarlo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Chiave del calendario del sito da dare a Booking e Airbnb (minimo 16 caratteri, obbligatoria in live)
ICAL_FEED_KEY=

# Ogni quanti minuti leggere i calendari di Booking e Airbnb (minimo 10)
ICAL_SYNC_MINUTES=30

# Percorso del database (facoltativo). Predefinito: data/approdo-demo.db o data/approdo.db
DATABASE_PATH=

# File di configurazione della struttura (facoltativo). Predefinito: config/struttura.json
STRUTTURA_PATH=

# --- Email ---
# Chi riceve l'avviso di ogni nuova richiesta (più indirizzi separati da virgola)
NOTIFY_EMAIL_TO=
# Casella che invia le email (quella del B&B o Gmail con "password per le app")
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
