{
  "name": "approdo",
  "version": "0.1.0",
  "private": true,
  "description": "Sito e prenotazioni dirette per B&B e case vacanza: calendario camere, orario di arrivo, area gestore, notifiche email e sincronizzazione iCal con Booking e Airbnb.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server.mjs",
    "dev": "node --no-warnings=ExperimentalWarning --watch server.mjs",
    "test": "node --no-warnings=ExperimentalWarning --test --test-force-exit tests/app.test.mjs",
    "check": "node scripts/check-config.mjs"
  },
  "dependencies": {
    "nodemailer": "^6.9.16"
  }
}
